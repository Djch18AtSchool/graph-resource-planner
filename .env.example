# Copie este archivo a .env (NO suba .env al repositorio)
# anthropic | ollama | offline   (si se omite: anthropic si hay API key, si no offline)
LLM_PROVIDER=offline

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high
ANTHROPIC_EFFORT=medium

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1
