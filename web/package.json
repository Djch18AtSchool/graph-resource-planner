    "@xyflow/react": "^13.0.2",
    "clsx": "^2.1.1",
    "d3-force": "^3.0.1",
    "lucide-react": "^1.77.0",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
